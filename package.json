{
  "name": "fitness-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8881",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/seed.ts",
    "db:seed:test": "tsx db/seed-test.ts",
    "test": "NODE_ENV=test tsx --test test/**/*.test.ts",
    "coach": "tsx scripts/coach.ts",
    "coach:smoke": "tsx scripts/coach-smoke.ts",
    "progress": "tsx scripts/progress.ts",
    "exercises:source": "bash -c \"cd scraper && uv sync && .venv/bin/musclewiki --output ../data/external/musclewiki.jsonl --delay 1.0\"",
    "exercises:import": "tsx scripts/import-exercises.ts",
    "exercises:match": "tsx scripts/match-exercises.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.28",
    "@ai-sdk/openai": "^4.0.42",
    "ai": "^7.0.66",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.6",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
