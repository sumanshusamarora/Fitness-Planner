# Used by the local dev server, drizzle-kit migrations, and the seed script.
DATABASE_URL=postgresql://fitness:fitness@localhost:5434/fitness

# Runtime AI coach provider keys. Keep secrets server-side only.
# Leave blank to use deterministic coach fallback.
OPEN_API_KEY=
DEEPSEEK_API_KEY=

# Provider-neutral model selection path. Leave blank to use the default split:
# high-effort planning -> openai:gpt-5.6-terra, quick decisions -> openai:gpt-5.6-luna.
# Set an explicit value to force a single model for all calls, e.g. deepseek:deepseek-chat.
COACH_LLM_MODEL=
